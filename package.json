{
  "name": "vision-ui-doctor",
  "version": "0.2.0-beta.1",
  "description": "Local public UI/UX audits, evidence-based agent handoffs and an ownership-aware Agent Skills installer",
  "type": "module",
  "bin": {
    "vision-ui-doctor": "./src/cli.js",
    "vision-ui-doctor-public": "./src/public-cli.js"
  },
  "files": ["src/", "skills/", "guides/", "examples/", "tests/fixtures/", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "audit:demo": "node src/cli.js audit --url http://127.0.0.1:4173 --out reports/demo"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {"type": "git", "url": "git+https://github.com/visionnumbers/vision-ui-doctor.git"},
  "bugs": {"url": "https://github.com/visionnumbers/vision-ui-doctor/issues"},
  "homepage": "https://github.com/visionnumbers/vision-ui-doctor#readme",
  "publishConfig": {"access": "public", "tag": "beta", "registry": "https://registry.npmjs.org/"},
  "keywords": [
    "responsive",
    "chromium",
    "agent-skills",
    "audit",
    "cli",
    "zero-dependencies"
  ]
}
